# Non-secret deployment settings. `lab-platform init` creates `.env` and mounted secret files.
LAB_VERSION=0.9.0-beta
LAB_CONTROL_PLANE_IMAGE=ghcr.io/mtzahor/lab-platform-control-plane
LAB_PUBLIC_HOST=lab.example.com
LAB_PUBLIC_URL=https://lab.example.com
LAB_ACME_EMAIL=lab-operators@example.com
LAB_LOG_LEVEL=INFO
LAB_POSTGRES_DB=lab_platform
LAB_POSTGRES_USER=lab_platform
LAB_DATABASE_POOL_SIZE=10
LAB_MAX_CONCURRENT_WORKFLOWS=20
LAB_MAX_ACTIVE_CI_SESSIONS=50
LAB_MAX_SSE_STREAMS=200
LAB_MAX_ARTIFACT_SIZE_MB=500
LAB_MAX_LOG_ARTIFACT_SIZE_MB=100
LAB_MAX_RESERVATION_DURATION_MINUTES=1440
LAB_RETENTION_DEFAULT_DAYS=30
LAB_RETENTION_FAILED_WORKFLOW_DAYS=90
LAB_RETENTION_FIRMWARE_DAYS=180
LAB_MINIMUM_AGENT_VERSION=0.8.0
LAB_TARGET_AGENT_VERSION=0.9.0-beta

# To use S3-compatible object storage, uncomment and configure these values.
# LAB_ARTIFACT_STORAGE_BACKEND=s3
# LAB_S3_BUCKET=lab-platform-artifacts
# LAB_S3_PREFIX=lab-platform
# LAB_S3_REGION=us-east-1
# LAB_S3_ENDPOINT_URL=https://s3.example.com
