# Optional post-v1 Decision Engine. Inject into the control-plane environment.
# Defaults are provisional and must be calibrated on recorded Lab Platform runs.
JEV_ENABLED=false
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=5000
JEV_DIAGNOSIS_MIN_CONFIDENCE=0.90
JEV_ACTION_MIN_CONFIDENCE=0.95
JEV_RETRY_SAFE_MIN_PROBABILITY=0.99
JEV_MODE=recommend
JEV_MAX_STATE_BYTES=32768
